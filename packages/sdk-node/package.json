{
  "name": "@getobservo/node",
  "version": "1.0.2",
  "description": "Node.js client for Observo log ingest",
  "license": "MIT",
  "readme": "README.md",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --minify --clean --target node18",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "node --input-type=module -e \"import fs from 'node:fs'; if (!fs.existsSync('README.md')) throw new Error('README.md is missing'); if (fs.statSync('README.md').size < 100) throw new Error('README.md is empty'); const pack = fs.readFileSync('package.json','utf8'); if (!JSON.parse(pack).files?.includes('README.md')) throw new Error('README.md must be listed in package.json files');\""
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Felix-Asante/observo"
  },
  "homepage": "https://observo-web.cwfelix.workers.dev",
  "bugs": {
    "url": "https://github.com/Felix-Asante/observo/issues"
  },
  "author": {
    "name": "Felix Asante",
    "email": "webdevfelix@gmail.com",
    "url": "https://github.com/Felix-Asante"
  },
  "keywords": [
    "observo",
    "logging",
    "logging-sdk",
    "observability",
    "nodejs-observability",
    "nodejs-logging"
  ]
}
